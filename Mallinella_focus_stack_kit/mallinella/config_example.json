{
  "output_dir": "renders",
  "resolution": [2048, 1536],
  "samples": 256,
  "denoise": true,
  "device": "OPTIX",

  "optics": {
    "mode": "lens",
    "focal_length_mm": 100,
    "f_number": 8,
    "magnification": "auto",
    "auto_margin": 0.08,
    "sensor_width_mm": 36.0,
    "coc_mm": null,
    "aperture_blades": 0
  },

  "stack": {
    "mode": "focus",
    "step_mm": null,
    "overlap": 0.7,
    "margin_mm": 0.2,
    "max_slices": 12
  },

  "background": { "substrate": "paper", "substrate_color": [0.55, 0.52, 0.47], "color": [0.75, 0.75, 0.75] },
  "lighting": { "dome_strength": 0.6, "softbox_power": 1.0, "jitter": 0.2 },
  "color": { "view_transform": "AgX", "exposure": 0.0 },
  "outputs": { "bit_depth": 8, "all_in_focus": true, "normals": true },

  "views": [
    { "name": "dorsal",          "azimuth": 0,   "elevation": 90, "roll": 0 },
    { "name": "dorsal_body_5x",  "azimuth": 0,   "elevation": 90, "roll": 0, "magnification": 2.5, "center": "body" },
    { "name": "frontal",         "azimuth": 0,   "elevation": 15 },
    { "name": "lateral_left",    "azimuth": 90,  "elevation": 10 },
    { "name": "oblique_fr_left", "azimuth": 45,  "elevation": 40 },
    { "name": "posterior",       "azimuth": 180, "elevation": 30 },
    { "name": "ventral",         "azimuth": 0,   "elevation": -90 },
    { "name": "tilted_specimen", "azimuth": 30,  "elevation": 55, "roll": 10, "specimen_rotation_deg": [0, 8, 20] }
  ]
}
